Código 4 - C
#include <stdio.h>

int contador(void) {
static int n = 0;
return ++n;
}
int main()
{
    contador(); 
    contador();
    printf("%d\n", contador());
}

Saída: 3

Conceito: variável local estática

Código 5 - Rust
fn dobra(v: &Vec<i32>) -> Vec<i32> {
    v.iter().map(|x| x * 2).collect()
}

fn main() {
    let v = vec![1, 2, 3];
    let d = dobra(&v);
    println!("{:?} {:?}", v, d);
}

Saída: [1, 2, 3] [2, 4, 6]

Conceito: modo de passagem por posse (move)

